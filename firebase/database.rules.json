{
  "rules": {
    ".read": false,
    ".write": false,

    "hub": {
      "online": {
        ".read": true,
        "$key": {
          ".write": "$key.matches(/^[a-z0-9]{1,16}$/)",
          ".validate": "newData.hasChildren(['t'])",
          "t": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },
      "stats": {
        "visits": {
          ".read": true,
          ".write": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || (data.isNumber() && newData.val() === data.val() + 1))"
        }
      },
      "hidden": { ".read": true },
      "settings": {
        "ageGate": { ".read": true }
      },
      "updateLog": { ".read": true }
    },

    "games": {
      "$code": {
        ".read": true,
        ".write": "$code.matches(/^[A-Z]{3,5}-[0-9]{2}$/)",
        ".validate": "newData.hasChild('phase')",
        "phase": { ".validate": "newData.isString() && newData.val().length <= 32" },
        "players": {
          "$i": {
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30 && !newData.val().contains('<')" }
          }
        }
      }
    },

    "banqueroll": {
      "$code": {
        ".read": true,
        ".write": "$code.matches(/^[A-Z]{3,5}-[0-9]{2}(-[a-z0-9]{1,3})?$/)",
        ".validate": "newData.hasChild('phase')",
        "phase": { ".validate": "newData.isString() && newData.val().length <= 32" },
        "players": {
          "$i": {
