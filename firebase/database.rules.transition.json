              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30 && !newData.val().contains('<')"
            }
          }
        },
        "hostUid": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
        }
      }
    },
    "uno": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && !newData.exists()",
      "$code": {
        ".read": true,
        ".write": "$code.matches(/^[A-Z]{3,5}-[0-9]{2}$/) || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChild('phase')",
        "phase": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "players": {
          "$i": {
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30 && !newData.val().contains('<')"
            }
          }
        },
        "hostUid": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
        }
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "ucHost": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && !newData.exists()",
      "$code": {
        ".read": "(auth != null && root.child('games').child($code).child('hostUid').val() === auth.uid && root.child('hub').child('settings').child('maintenance').val() !== true && root.child('hub').child('hidden').child('undercover').val() !== true && !root.child('bans').child(auth.uid).exists()) || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".write": "(auth != null && root.child('games').child($code).child('hostUid').val() === auth.uid && root.child('hub').child('settings').child('maintenance').val() !== true && root.child('hub').child('hidden').child('undercover').val() !== true && !root.child('bans').child(auth.uid).exists()) || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['civilWord', 'undercoverWord', 'roles'])",
        "civilWord": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
        },
        "undercoverWord": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
        },
        "roles": {
          "$i": {
            ".validate": "newData.isString() && newData.val().matches(/^(civil|undercover|mrwhite)$/)"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "ucSecret": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && !newData.exists()",
      "$code": {
        ".read": "(auth != null && root.child('games').child($code).child('hostUid').val() === auth.uid && root.child('hub').child('settings').child('maintenance').val() !== true && root.child('hub').child('hidden').child('undercover').val() !== true && !root.child('bans').child(auth.uid).exists()) || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".write": "(auth != null && root.child('games').child($code).child('hostUid').val() === auth.uid && root.child('hub').child('settings').child('maintenance').val() !== true && root.child('hub').child('hidden').child('undercover').val() !== true && !root.child('bans').child(auth.uid).exists()) || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid && root.child('hub').child('settings').child('maintenance').val() !== true && root.child('hub').child('hidden').child('undercover').val() !== true && !root.child('bans').child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['role'])",
          "role": {
            ".validate": "newData.isString() && newData.val().matches(/^(civil|undercover|mrwhite)$/)"
          },
          "word": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "wr": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && !newData.exists()",
      "$code": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && !newData.exists()"
      }
    },
    "adminLog": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['ts', 'cat', 'msg', 'by'])",
        "ts": {
          ".validate": "newData.val() === now"
        },
        "cat": {
          ".validate": "newData.isString() && newData.val().matches(/^(connexion|jeu|reglage|partie|joueur|stats|global)$/)"
        },
        "msg": {
          ".validate": "newData.isString() && newData.val().length <= 300 && !newData.val().contains('<')"
        },
        "target": {
          ".validate": "newData.isString() && newData.val().length <= 60 && !newData.val().contains('<')"
        },
        "by": {
          ".validate": "newData.val() === auth.uid"
        },
        "$other": {
          ".validate": false
        }
      }
