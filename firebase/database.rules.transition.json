        ".validate": "newData.hasChild('phase')",
        "phase": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "players": {
          "$i": {
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30 && !newData.val().contains('<')"
            }
          }
        },
        "hostUid": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
        }
      }
    },
    "qec2": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && !newData.exists()",
      "$code": {
        ".read": true,
