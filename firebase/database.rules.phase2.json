              ".validate": false
            }
          }
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && root.child('hub').child('settings').child('maintenance').val() !== true && auth.uid === $uid && root.child('ms').child($code).child('members').child(auth.uid).exists()",
            ".validate": "newData.isNumber()"
          }
        },
        "req": {
          "$id": {
            ".write": "auth != null && root.child('hub').child('settings').child('maintenance').val() !== true && root.child('ms').child($code).child('members').child(auth.uid).exists() && ((!data.exists() && newData.child('by').val() === auth.uid) || (data.exists() && !newData.exists() && root.child('ms').child($code).child('hostUid').val() === auth.uid))",
            ".validate": "$id.matches(/^[A-Za-z0-9_-]{6,40}$/) && newData.hasChildren(['by', 'c', 'net'])",
            "by": {
              ".validate": "newData.isString()"
            },
            "c": {
              ".validate": "newData.isString() && newData.val().length <= 2000"
            },
            "net": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "cmds": {
          ".write": "auth != null && root.child('hub').child('settings').child('maintenance').val() !== true && root.child('ms').child($code).child('hostUid').val() === auth.uid && !newData.exists()",
          "$seq": {
            ".write": "auth != null && root.child('hub').child('settings').child('maintenance').val() !== true && root.child('ms').child($code).child('hostUid').val() === auth.uid && !data.exists()",
            ".validate": "$seq.matches(/^c[0-9]{6}$/) && newData.hasChildren(['id', 'by', 'tick', 'c', 'net'])",
            "id": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "by": {
              ".validate": "newData.isString() && (newData.val() === auth.uid || root.child('ms').child($code).child('req').child(newData.parent().child('id').val()).child('by').val() === newData.val()) && (root.child('ms').child($code).child('cfg').child('kind').val() !== 'versus' || newData.parent().child('net').val() === root.child('ms').child($code).child('cfg').child('seats').child(newData.val()).val() || (newData.val() === auth.uid && newData.parent().child('net').val() === -1))"
            },
            "tick": {
              ".validate": "newData.isNumber()"
            },
            "net": {
              ".validate": "newData.isNumber()"
            },
            "c": {
              ".validate": "newData.isString() && newData.val().length <= 2000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "head": {
          ".write": "auth != null && root.child('hub').child('settings').child('maintenance').val() !== true && root.child('ms').child($code).child('hostUid').val() === auth.uid",
          ".validate": "newData.hasChildren(['tick', 'n'])",
          "tick": {
            ".validate": "newData.isNumber()"
          },
          "n": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "hash": {
          ".write": "auth != null && root.child('hub').child('settings').child('maintenance').val() !== true && root.child('ms').child($code).child('hostUid').val() === auth.uid",
          "tick": {
            ".validate": "newData.isNumber()"
          },
          "h": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "snap": {
          ".write": "auth != null && root.child('hub').child('settings').child('maintenance').val() !== true && root.child('ms').child($code).child('hostUid').val() === auth.uid",
          "tick": {
            ".validate": "newData.isNumber()"
          },
          "s": {
            ".validate": "newData.isString() && newData.val().length <= 400000"
          },
          "$other": {
            ".validate": false
          }
        },
        "result": {
          ".write": "auth != null && root.child('hub').child('settings').child('maintenance').val() !== true && root.child('ms').child($code).child('hostUid').val() === auth.uid",
          ".validate": "newData.hasChildren(['outcome'])",
          "outcome": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "tick": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "ucHost": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && !newData.exists()",
      "$code": {
        ".read": "(auth != null && root.child('games').child($code).child('hostUid').val() === auth.uid && root.child('hub').child('settings').child('maintenance').val() !== true) || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".write": "(auth != null && root.child('games').child($code).child('hostUid').val() === auth.uid && root.child('hub').child('settings').child('maintenance').val() !== true) || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['civilWord', 'undercoverWord', 'roles'])",
        "civilWord": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
        },
        "undercoverWord": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
        },
        "roles": {
          "$i": {
            ".validate": "newData.isString() && newData.val().matches(/^(civil|undercover|mrwhite)$/)"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "ucSecret": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && !newData.exists()",
      "$code": {
        ".read": "(auth != null && root.child('games').child($code).child('hostUid').val() === auth.uid && root.child('hub').child('settings').child('maintenance').val() !== true) || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".write": "(auth != null && root.child('games').child($code).child('hostUid').val() === auth.uid && root.child('hub').child('settings').child('maintenance').val() !== true) || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid && root.child('hub').child('settings').child('maintenance').val() !== true",
          ".validate": "newData.hasChildren(['role'])",
          "role": {
            ".validate": "newData.isString() && newData.val().matches(/^(civil|undercover|mrwhite)$/)"
          },
          "word": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
